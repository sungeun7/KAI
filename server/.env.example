# 이 파일을 복사해 .env 로 저장한 뒤 키만 넣으세요. .env 는 Git 에 올리지 마세요.
OPENAI_API_KEY=sk-여기에_키_붙여넣기

# --- SAP 연계 (선택) ---
# 질문 시 includeSapOdata:true 이면 이 URL을 GET 해서 LLM 컨텍스트에 넣습니다.
# 예: S/4 OData 엔티티 전체 URL (?$format=json 권장)
# SAP_ODATA_URL=https://호스트/sap/opu/odata/sap/API_BUSINESS_PARTNER/A_BusinessPartner?$top=5&$format=json
#
# "일주일 전까지 미처리된 입고 문서 보여줘" 같은 질문 → SAP OData GET 후 답변.
# 미처리 입고 전용 $filter 가 들어간 URL을 권장합니다. 없으면 SAP_ODATA_URL 을 대신 사용합니다.
# 날짜 치환: {DATE_7D_AGO} {DATE_WEEK_AGO} {DATE_TODAY} (YYYY-MM-DD)
# SAP_ODATA_INBOUND_PENDING_URL=https://호스트/odata/Inbound?$filter=CreateDate ge datetime'{DATE_7D_AGO}T00:00:00'&$format=json
#
# --- SAP B1 SQL Server (입고 OPDN 직접 조회, OData보다 우선) ---
# 예: FROM [SBO_MACRO].[dbo].[OPDN] WHERE DocDate >= @fromDate
# 한 줄 연결 문자열(권장):
# KAI_SBO_SQL_CONNECTION_STRING=Server=호스트,1433;Database=SBO_MACRO;User Id=사용자;Password=비밀;Encrypt=true;TrustServerCertificate=true
# 또는 분리:
# KAI_SBO_SQL_SERVER=호스트
# KAI_SBO_SQL_PORT=1433
# KAI_SBO_SQL_DATABASE=SBO_MACRO
# KAI_SBO_SQL_USER=사용자
# KAI_SBO_SQL_PASSWORD=비밀
# (선택) 다른 DB에 붙어 3부 이름으로 조회할 때:
# KAI_SBO_OPDN_TABLE=[SBO_MACRO].[dbo].[OPDN]
# 입고 라인(PDN1) — 입고취소 후 출고 시 품목 채움
# KAI_SBO_PDN1_TABLE=[SBO_MACRO].[dbo].[PDN1]
# 배치번호 자동조회용 트랜잭션 테이블(기본: [dbo].[IBT1], [SBO_MACRO].[dbo].[IBT1] 순회)
# KAI_SBO_IBT1_TABLE=[SBO_MACRO].[dbo].[IBT1]
# 배치번호 재고 보강(OBTQ/OBTN) 테이블 지정(선택)
# KAI_SBO_OBTQ_TABLE=[SBO_MACRO].[dbo].[OBTQ]
# KAI_SBO_OBTN_TABLE=[SBO_MACRO].[dbo].[OBTN]
# 역출고 시 입고창고(frWh)→목적지(toWh). 미설정 시 SAP_DEFAULT_TO_WAREHOUSE
# KAI_SBO_CANCEL_OUTBOUND_TO_WH=AA100
# (선택) 추가 조건: KAI_SBO_OPDN_EXTRA_WHERE=Canceled = 'N'
# (선택) 최대 행: KAI_SBO_OPDN_MAX_ROWS=200
# (주의) OPDN 마감·입고예정취소 등 UPDATE 허용(기본 false): true일 때만 실행
# KAI_SBO_SQL_ALLOW_UPDATE=true
# 입고 예정 취소: OPOR 연동값 C + 닫기, OPDN은 컬럼 U_WMSNY에 값 N
# KAI_SBO_OPOR_TABLE=[SBO_MACRO].[dbo].[OPOR]
# KAI_SBO_OPOR_LINK_FIELD=U_WMSNY
# KAI_SBO_OPOR_LINK_VALUE_C=C
# KAI_SBO_OPDN_LINK_VALUE_N=N
# (선택) 입고예정취소 시 DocEntry가 ORRR/OWTQ일 때 테이블 지정
# KAI_SBO_ORRR_TABLE=[SBO_MACRO].[dbo].[ORRR]
# KAI_SBO_OWTQ_TABLE=[SBO_MACRO].[dbo].[OWTQ]
# 출하 예정 취소: ORDR는 PKL1 라인 삭제 후 U_WMSNY→N, OWTQ는 DocStatus=C·U_WMSNY→C(기본 OPOR 연동값과 동일)
# KAI_SBO_ORDR_TABLE=[SBO_MACRO].[dbo].[ORDR]
# 판매오더 라인(RDR1) — 자연어 출하(CVA002 ORDR) 시 prodList 자동 채움
# KAI_SBO_RDR1_TABLE=[SBO_MACRO].[dbo].[RDR1]
# RDR1에 행이 없을 때 ORDR에서 DocNum→DocEntry 해석 후 재조회(기본 true)
# KAI_SBO_RDR1_RESOLVE_DOCNUM=true
# KAI_SBO_PKL1_TABLE=[SBO_MACRO].[dbo].[PKL1]
# KAI_SBO_ORDR_LINK_FIELD=U_WMSNY
# KAI_SBO_ORDR_LINK_VALUE_N=N
# (선택) 출하 취소 시 OWTQ 연동값 — 미설정 시 KAI_SBO_OPOR_LINK_VALUE_C
# KAI_SBO_OUTBOUND_OWTQ_LINK_VALUE=C
# 출하 예정 취소 응답에 판매오더 연결 납품(ODLN) SQL 진단 — 끄려면 false
# KAI_SBO_ODLN_DIAG=true
# (선택) 회사 DB에 맞게 납품 테이블 지정
# KAI_SBO_ODLN_TABLE=[SBO_MACRO].[dbo].[ODLN]
# KAI_SBO_DLN1_TABLE=[SBO_MACRO].[dbo].[DLN1]
# OWTR — SAP B1에서 보는 회사 DB와 동일하게 지정 권장. 미지정 시 [dbo].[OWTR]·[SBO_MACRO].[dbo].[OWTR] 둘 다 조회해 취소 여부가 SAP 화면과 어긋날 수 있음
# KAI_SBO_OWTR_TABLE=[SBO_MACRO].[dbo].[OWTR]
# 위 둘 다 존재할 때 CANCELED=Y 판단을 **모든 테이블**에서 읽으려면 true. 기본은 첫 테이블만
# KAI_SBO_OWTR_STATUS_USE_ALL_TABLES=false
# 재고이전(CSM001) 시 질문에 OWTQ DocEntry가 있으면 WTQ1 라인 조회
# OWTR 전송 성공 후 동일 DocEntry의 OWTQ를 SQL로 마감(U_WMSNY+DocStatus). 끄려면: false
# KAI_SBO_CLOSE_OWTQ_AFTER_STOCK_TRANSFER=true
# 반품마감 취소: OWTR이 이미 CANCELED=Y일 때 CBP007 생략 후, WTR1로 연계 OWTQ DocEntry를 찾아 마감(U_WMSNY+DocStatus). 끄려면: false
# KAI_SBO_CLOSE_OWTQ_WHEN_OWTR_ALREADY_CANCELED=true
# OWTR이 SQL상 이미 취소여도 WMS CBP007을 **부르지 않으려면** true. 기본 false(호출함, SAP/WMS 불일치 시 동기화)
# KAI_SBO_CBP007_SKIP_WHEN_OWTR_ALREADY_CANCELED=false
# CSM001: frWh===toWh 이고 frLoc/toLoc 비어 있으면 SAP -1470000519 방지로 기본 출고/입고 창고로 분리. 동일창고+빈만 이동이면 false
# KAI_SBO_CSM001_SAME_WH_SPLIT=true
# KAI_SBO_WTQ1_TABLE=[SBO_MACRO].[dbo].[WTQ1]
# 출하유형 ZSM108 `O-*`·레거시 OB91/93(기타출하) 자연어 처리 시 WTQ1 조회 — DocNum→DocEntry (기본 true)
# KAI_SBO_WTQ1_RESOLVE_DOCNUM=true
# WTQ1에 배치가 없으면 BTQ1+OBTN → IBT1(OWTQ BaseType)+OBTN → 출고창고+품목 OBTQ 보강. 끄려면: KAI_SBO_WTQ1_BATCH_ENRICH=false
# KAI_SBO_BTQ1_TABLE=[SBO_MACRO].[dbo].[BTQ1]
# IBT1.BaseType 이 다르면(기본 재고이전요청 1250000001): KAI_SBO_OWTQ_IBT1_BASE_TYPE=1250000001
# 마지막 OBTQ 재고 배치 폴백 끄기: KAI_SBO_WTQ1_STOCK_BATCH_FALLBACK=false
# SQL 성공 후에도 OData를 같이 붙이려면: KAI_SBO_SQL_AND_ODATA=true
# 반품마감 CBP006 (ORDN 생성 + ORRR Close). 테스트: SAP_CBP006_MOCK=true
# erpBatchNo가 OBTN.AbsEntry(긴 숫자)일 때 DistNumber로 치환. 끄려면: false
# KAI_SBO_CBP006_RESOLVE_OBTN_BATCH=true
# 우선 BTR1/BTQ1+라인(erpReqNo+erpLineNo)으로 DistNumber 조회. 끄려면: false
# KAI_SBO_CBP006_RESOLVE_LINE_FIRST=true
# AbsEntry로 볼 최소 숫자 자릿수(기본 10)
# KAI_SBO_OBTN_ABS_ENTRY_MIN_LEN=10
# CBP006 전체 URL(포트·경로는 IIS/서비스 스웨거와 동일해야 함). HTTP 404면 경로 오류이므로 아래처럼 정확히 지정.
# 여러 개 시도: 쉼표로 나열(앞에서부터 순서대로). 포트 생략 시 SAP_CBP006_PORTS 로 여러 포트를 순회.
# 예: SAP_CBP006_URL=http://192.168.0.37:44346/CBP006
# 예: SAP_CBP006_URL=https://192.168.0.37:44346/api/CBP006,http://192.168.0.37:8080/CBP006
# SAP_CBP006_URL=http://192.168.0.37/CBP006
# 경로 자동 후보(기본: /CBP006,/api/CBP006,/cbp006,/api/cbp006)
# SAP_CBP006_PATH_CANDIDATES=/CBP006,/api/CBP006
# 재고이전 취소 CBP007 (DocEntry만으로 취소 요청)
# POST /api/query 본문 예: {"question":"반품마감 취소 DocEntry 70185","docEntries":[70185],"erpReqExtra":70186}
# 질문에만 `70194`처럼 WMS용 숫자를 적어도(키워드 없이) OWTR DocEntry와 다르면 erpReq 후보로 합류 — SQL 비고가 비어도 동작(시도 순서: B1 연결·OWTR DocEntry 먼저, 비고·질문 힌트는 뒤)
# 반품마감 취소: 질문에 OWTR·WMS 번호가 둘 다 있으면 CBP007은 OWTR 한 건만(복합 키 방지). 여러 OWTR을 한 번에 취소하려면 true
# KAI_SBO_RETURN_CLOSE_CBP007_MULTI_OWTR=false
# 반품마감 취소에서 CBP007 실패 시 OWTR SQL fallback 허용(기본 true)
# KAI_SBO_RETURN_CLOSE_SQL_OWTR_FALLBACK=true
# ORRR 원천에 연결된 재고이전(OWTR) 최대 조회 건수 — WTR1.BaseEntry=ORRR DocEntry
# KAI_SBO_RETURN_LINKED_OWTR_MAX=50
# — 관계맵의 OWTQ DocEntry(70186)를 OWTR(70185)보다 먼저 erpReq로 시도
# SAP_CBP007_URL=https://localhost:44346/CBP007
# ECONNREFUSED: 해당 호스트·포트에 서비스 없음/방화벽 — KAI가 도는 PC에서 URL 접속 가능한지 먼저 확인
# 포트·경로 자동 확장(CBP006과 동일 개념). URL에 포트가 있으면 포트 확장은 생략됩니다.
# SAP_CBP007_PORTS=44346,8080
# SAP_CBP007_PATH_CANDIDATES=/CBP007,/api/CBP007,/cbp007,/api/cbp007
# SAP_CBP007_APIKEY=emdc
# SAP_CBP007_BIZSEQ=1
# bizSeq=0 변형(일부 서버에서 CommandText 미설정 오류) — 기본 false, 필요 시만 true
# SAP_CBP007_BIZSEQ_TRY_ZERO=false
# SAP_CBP007_USER=KAI
# 스웨거 샘플(reqList: inwhTypeCd·centerSeq·procBundleNo) — 취소 API가 이 형태면 필수에 가깝습니다.
# SAP_CBP007_INWH_TYPE_CD=
# SAP_CBP007_CENTER_SEQ=0
# 여러 조합 자동 시도(쉼표). INWH만 비어 있으면 O-300·O-301·ETC가 자동 포함됩니다(센터만 지정해도 동일).
# SAP_CBP007_INWH_TYPE_CD_CANDIDATES=
# SAP_CBP007_CENTER_SEQ_CANDIDATES=
# SAP_CBP007_MAX_INWH_CENTER_COMBOS=16
# WTR1에서 OWTR당 DISTINCT BaseEntry 최대 개수(erpReqNo 후보)
# SAP_CBP007_MAX_OWTQ_BASE_ENTRIES=12
# WTR1 역조회: BaseEntry=입력DocEntry 로 실제 OWTR 헤더 DocEntry 후보(OWTQ↔OWTR 번호 불일치 시) — 기본 true, 끄려면 false
# SAP_CBP007_REVERSE_WTR1_BASE_LOOKUP=true
# 역조회 시 DISTINCT OWTR DocEntry 최대 개수
# SAP_CBP007_MAX_OWTR_FROM_OWTQ_BASE=12
# OWTR DocNum/NumAtCard로 OWTQ.DocNum 매칭 시 DocEntry 최대 개수
# SAP_CBP007_MAX_OWTQ_BY_DOCNUM=12
# 관계맵 연결 OWTQ·OWTR의 DocNum이 다를 때 역매칭이 오해를 부릴 수 있음 — 끄려면 false
# SAP_CBP007_OWTQ_BY_OWTR_DOCNUM=true
# DocNum으로 찾은 OWTQ DocEntry가 OWTR DocEntry와 같은 숫자면 제외(서로 다른 테이블이어도 조회 혼동 방지) — 끄려면 false
# SAP_CBP007_OWTQ_DOCNUM_EXCLUDE_SAME_DE=true
# SQL로 못 찾은 WMS 전용 숫자키를 쉼표로 추가 시도 (int erpReqNo)
# SAP_CBP007_ERPREQ_EXTRA=
# OWTR 헤더 UDF에서 숫자 erpReq 후보 자동 추출 (쉼표, B1 컬럼명 예: U_WmsReqNo)
# SAP_CBP007_OWTR_UDF_ERPREQ=
# OWTR 헤더 Comments/JrnlMemo·WTR1 라인 FreeTxt 비고에서 자동 추출 — dbo·SBO_MACRO 등 후보 테이블 **전부**에서 병합(WTR1 링크가 비어도 CBP007 erpReq 후보 맨 앞)
# 키워드 없이 숫자만 있는 비고도 후보로 쓰려면 true(기본). 오탐 시 false
# SAP_CBP007_ERPREQ_LOOSE_DIGITS=true
# 후보 env 없을 때 O-300·O-301·ETC와 center 0·1 그리드 자동 시도 (기본 true)
# SAP_CBP007_INWH_CENTER_TRY_DEFAULTS=true
# SAP_CBP007_PROC_BUNDLE_NO=
# reqList.wmsReqNo: 기본은 ifKey와 동일(랜덤). WMS가 재고이전(OWTR) 문서키로만 조회하면 erpReqNo와 같은 값이 필요할 수 있음 — 아래 중 하나
# SAP_CBP007_WMS_REQ_NO_MODE=erpReq
# SAP_CBP007_WMS_REQ_NO_SAME_AS_ERPREQ=true
# 스웨거 샘플 본문 예(필드명): apikey, bizSeq, reqList[].ifKey, inwhTypeCd, centerSeq, wmsReqNo, erpReqNo, procYmd, procHms, procUserId, procBundleNo
# CSM003와 유사한 reqList 전송 시 등록유형( inwhTypeCd 미설정 시 SAP_CBP007_ETC_TYPE_CD 로 대체 시도)
# SAP_CBP007_ETC_TYPE_CD=O-300
# SAP_CBP007_NOTE=재고이전 취소
# 스웨거 샘플 JSON 그대로(첫 DocEntry만): 문자열 {{erpReqNo}} 를 치환
# SAP_CBP007_RAW_JSON={"apikey":"emdc","bizSeq":1,"reqList":[{"erpReqNo":"{{erpReqNo}}"}]}
# SAP_CBP007_TLS_INSECURE=true
# SAP_CBP007_TRY_TIMEOUT_MS=20000
# CBP007 HTTP 순차 시도 전체 상한(ms) — 기본 90초. 0이면 무제한(응답 대기만 지속될 수 있음)
# SAP_CBP007_TOTAL_BUDGET_MS=90000
# 변형×URL당 POST 횟수 상한 — 기본 72. 0이면 무제한
# SAP_CBP007_MAX_HTTP_ATTEMPTS=72
# erpReqNo 후보 전략 최대 개수(ObjType·Series-DocNum·OWTQ 등 SQL에서 순서대로 생성)
# SAP_CBP007_MAX_STRATEGIES=20
# erpReqNo를 숫자만 시도 (SQL int 바인딩 시 `67-70176` 등 복합 문자열 제외) — 기본 true
# SAP_CBP007_ERPREQ_INT_ONLY=true
# varchar erpReqNo 서버에서만: ObjType·Series 복합 키 추가 + INT_ONLY=false
# SAP_CBP007_ERPREQ_ALLOW_COMPOSITE=false
# SAP_CBP007_ERPREQ_OBJTYPE_OWTR=67
# SAP_CBP007_ERPREQ_OBJTYPE_OWTQ=1250000001
# SAP_CBP007_ERPREQ_SERIES_SEP=-
# DocEntry/DocNum 자리수 0 패딩 (0이면 생략)
# SAP_CBP007_ERPREQ_ZERO_PAD=0
# KAI_SBO_RRR1_TABLE=[SBO_MACRO].[dbo].[RRR1]
# RRR1에 배치 없을 때 BTR1+OBTN → BTQ1+OBTN 보강. 끄려면: KAI_SBO_RRR1_BATCH_ENRICH=false
# KAI_SBO_BTR1_TABLE=[SBO_MACRO].[dbo].[BTR1]
# 비우면 OData 호출 시 manager / emdc 사용
# SAP_USER=
# SAP_PASSWORD=
# 또는 이미 "Bearer ..." / "Basic ..." 문자열이 있으면:
# SAP_AUTHORIZATION=Basic base64또는Bearer토큰

# --- DI 서버 (권장: KAI → DI → SAP) ---
# DI_SERVER_URL=https://di.example.com
# DI_JOURNAL_PATH=/kai/journal
# DI_ODATA_PATH=/kai/odata
# 재고이전(CSM001) DI 경유 시 경로 (설정 시 SAP_STOCK_TRANSFER_URL 대신 DI로 전송)
# DI_STOCK_TRANSFER_PATH=/kai/stock-transfer
# DI_STOCK_TRANSFER_WRAP=true  (바디를 { source: "KAI", stockTransferRequest } 로 감쌀 때)
# DI_API_KEY=Bearer ...   (또는 DI_KAI_USER / DI_KAI_PASSWORD)

# --- SAP 분개 직접 POST (DI 미사용 시) ---
# SAP_JOURNAL_POST_URL=https://호스트/sap/bc/.../kai_journal
# proposal만내려면: SAP_JOURNAL_POST_RAW=true
# 실SAP 없이 데모: SAP_JOURNAL_MOCK=true
# SAP_COMPANY_CODE=1000

# 재고이전 CSM001 (기본값: http://192.168.0.37/CSM001)
# add/Controllers·Models(CSM001) API 형식 사용 시 아래 켜기
# SAP_STOCK_TRANSFER_CSM001_FORMAT=true
# SAP_CSM001_APIKEY=emdc
# SAP_CSM001_BIZSEQ=1
# SAP_CSM001_USER=KAI
# 배치번호 자동생성(비권장): 기본은 생성 안 함. 필요하면 auto
# SAP_CSM001_BATCH_STRATEGY=auto
# (로컬 Swagger 예: https://localhost:44346/swagger/index.html)
# SAP_STOCK_TRANSFER_URL=https://localhost:44346/CSM001
#
# 출하처리 CVA002 — ODLN(ORDR) / OWTR(OWTQ) / OIGE(OWTQ+EtcOutbizTypeCd) (add/Controllers/CVA002.cs)
# 설정 시 질문에 CVA002 Swagger JSON(reqList·erpReqTypCd 등) 붙이면 POST /api/query 가 전송
# SAP_CVA002_URL=https://localhost:44346/CVA002
# SAP_CVA002_APIKEY=emdc
# SAP_CVA002_BIZSEQ=1
# SAP_CVA002_USER=KAI
# SAP_CVA002_TRY_TIMEOUT_MS=30000
# (전송 실패 `20` / `This operation was aborted` 는 대개 이 한도 초과 — ms 늘리기)
# 로컬 https 자체서명:
# SAP_CVA002_TLS_INSECURE=true
# SAP_CVA002_MOCK=true
#
# 출하처리 취소 CVA003 — 납품(ODLN) 역분개·재고이전(OWTR) 취소 등 (add/Controllers/CVA003.cs)
# SAP_CVA003_URL=https://localhost:44346/CVA003
# SAP_CVA003_APIKEY=emdc
# SAP_CVA003_BIZSEQ=1
# SAP_CVA003_USER=KAI
# SAP_CVA003_TRY_TIMEOUT_MS=30000
# SAP_CVA003_TLS_INSECURE=true
#
# ORDR→ODLN 전송 전 RDR1/BTQ1/OBTQ로 ErpBatchNo(OBTN DistNumber) 자동 보강 — DI 480000112 방지. 끄려면 false
# KAI_SBO_CVA002_RESOLVE_BATCH=true
# 출하유형 ZSM108 `O-*`(예: O-900 기타출고)·레거시 OB91·OB93(기타출하) → KAI가 erpReqTypCd 비어 있을 때 OWTQ 로 보완. EtcOutbizTypeCd 비어 있으면 OutbizTypeCd와 동일하게 채워 OIGE 분기(서버 CVA002.cs 수정 불필요).
# 자연어·JSON에「기타출고/기타출하」만 있을 때 OutbizTypeCd 기본값 — [@ZSM108H].Code 와 일치해야 함(기본 O-900)
# KAI_CVA002_DEFAULT_ETC_OUTBIZ=O-900
# (선택) 기타출하로 취급할 추가 코드(쉼표 구분). isEtcOutbizOwtqCode 에 합류
# KAI_CVA002_ETC_OUTBIZ_CODES=
# 입고취소 후 출고문서(예외출고): CSM003
# SAP_GOODS_ISSUE_URL=https://localhost:44346/CSM003
# SAP_CSM003_APIKEY=emdc
# SAP_CSM003_BIZSEQ=1
# SAP_CSM003_USER=KAI
# SAP_CSM003_ETC_TYPE_CD=O-300
# 로컬 https 자체서명일 때만(개발용):
# SAP_STOCK_TRANSFER_TLS_INSECURE=true
# 포트 생략 시 8080→8000→8001… 자동 시도 (순서 변경:)
# SAP_STOCK_TRANSFER_PORTS=8443,8080,8000,80
# SAP_STOCK_TRANSFER_TRY_TIMEOUT_MS=20000
# 플랜트 placeholder 방지 기본값
# SAP_DEFAULT_WERKS=1000
# SAP_DEFAULT_WERKS_FROM=1000
# SAP_DEFAULT_WERKS_TO=1000
# B1 재고 이전 폼 기본값 (documents/재고이동.PNG 참고)
# SAP_DEFAULT_FROM_WAREHOUSE=AA120
# SAP_DEFAULT_TO_WAREHOUSE=AA100
# B1 창고가 1000처럼 숫자4자리인 DB만: KAI_SBO_ALLOW_NUMERIC_WAREHOUSE=true
# SAP_STOCK_TRANSFER_SERIES=주회
# SAP_STOCK_TRANSFER_MOCK=true

# 입고처리 CBP002 — 반드시 ASP.NET(CBP002Controller)이 떠 있는 주소로 설정.
# 8080은 KAI Node 서버라 여기 쓰면 "Cannot POST /CBP002" 발생. 포트까지 포함 권장.
# SAP_INBOUND_PROCESS_URL=http://192.168.0.37:44346/CBP002
# SAP_INBOUND_PROCESS_URL=https://localhost:44346/CBP002
# 로컬 https 자체서명일 때만(개발용):
# SAP_INBOUND_PROCESS_TLS_INSECURE=true
#
# (스톡이전과 같은 포트 자동시도도 가능)
# SAP_INBOUND_PROCESS_PORTS=8443,8080,8000,80
# SAP_INBOUND_PROCESS_TRY_TIMEOUT_MS=20000
#
# CBP002 APIKEY/BizSeq/User (body에 들어감)
# SAP_CBP002_APIKEY=emdc
# SAP_CBP002_BIZSEQ=1
# SAP_CBP002_USER=KAI
#
# (선택) 입고처리 모의 실행(실전기 X)
# SAP_INBOUND_PROCESS_MOCK=true
